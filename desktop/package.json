{
  "name": "wilytrader",
  "version": "0.4.10",
  "description": "WilyTrader local trading capture app and localhost bridge.",
  "main": "dist/main/main.js",
  "author": "Jason Koprowski",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Koprowski/WilyTrader.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.wilytrader.app",
    "productName": "WilyTrader",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "wilytrader-${version}-desktop-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WilyTrader"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.4.0"
  }
}
