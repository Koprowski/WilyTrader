{
  "manifest_version": 3,
  "name": "WilyTrader",
  "version": "0.4.11",
  "description": "Local-only paper trading overlay for Padre.gg and Axiom with execution-ledger export.",
  "permissions": ["storage", "downloads", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:17365/*",
    "https://api.github.com/repos/Koprowski/WilyTrader/*",
    "https://trade.padre.gg/*",
    "https://axiom.trade/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://trade.padre.gg/*", "https://axiom.trade/*"],
      "css": ["src/styles.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/userscript-wrapper.user.js"],
      "matches": ["https://axiom.trade/*"]
    },
    {
      "resources": ["assets/cash-register-sound.mp3"],
      "matches": ["https://trade.padre.gg/*", "https://axiom.trade/*"]
    }
  ]
}
