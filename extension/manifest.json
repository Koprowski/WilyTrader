{
  "manifest_version": 3,
  "name": "WilyTrader",
  "version": "0.1.19",
  "description": "Local-only paper trading overlay for Padre.gg with execution-ledger export.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["http://127.0.0.1:17365/*", "<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://trade.padre.gg/*"],
      "css": ["src/styles.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
